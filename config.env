# VEW Deployment Configuration
# Copy to deploy-config.env and fill in values, then run:
#   ./deploy.sh --config deploy-config.env

# Required
AWS_ACCOUNT_ID="123456789012"
AWS_REGION="us-east-1"
# Comma-separated regions where spoke workbenches may be provisioned.
ENABLED_WORKBENCH_REGIONS="us-east-1"
ENVIRONMENT="dev"
ORG_PREFIX="proserve"
APP_PREFIX="wb"
ADMIN_EMAIL="admin@example.com"
ADMIN_USER_ID="ADMIN"

# AWS CLI profiles (leave empty for default)
AWS_PROFILE_HUB=""
AWS_PROFILE_SPOKE=""

# OIDC federation (leave empty for manual Cognito users)
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_ISSUER_URL=""
OIDC_USER_ID_CLAIM="sub"
# Optional provider-specific logout URL. Use {appDns} where the application
# origin should be substituted, for example:
# https://identity.example/logout?return_to={appDns}/login
OIDC_LOGOUT_URL=""

# TLS and custom domain (leave empty for CloudFront-only access)
CERT_ARN=""
CERT_ARN_US_EAST_1=""
CUSTOM_DOMAIN=""
API_CUSTOM_DOMAIN=""

# Private deployment (internal ALB in a VPC instead of CloudFront).
# When true, CUSTOM_DOMAIN and API_CUSTOM_DOMAIN are required and the deployment
# is not pinned to us-east-1. PRIVATE_DNS_AUTOMATE creates a Route 53 private
# hosted zone (associated with the hub VPC) with alias records to both ALBs.
#
# Certificate: set CERT_ARN to a regional ACM certificate in AWS_REGION to bring
# your own. If left empty in private mode, the script generates a self-signed
# certificate (SANs for both domains) and imports it into ACM — free and
# self-contained, but clients must trust it (distribute it to trust stores).
PRIVATE_DEPLOYMENT="false"
PRIVATE_DNS_AUTOMATE="true"
PRIVATE_DNS_ZONE=""

# Name tag of an existing VPC in the hub account to deploy into. Empty means
# VEW derives the name from the prefixes above and creates the VPC if it is
# absent.
#
# Set this when the organisation provisions networking centrally. Such an
# organisation may also deny ec2:CreateVpc outright, in which case leaving this
# empty fails the deploy with an authorization error rather than a missing VPC.
HUB_VPC_NAME=""

# Comma-separated Name tags of subnets in that VPC the AMI factory may build in.
# It picks whichever has the most free addresses, so list the tier with room and
# outbound access. Empty derives names VEW only creates itself.
HUB_SUBNET_NAMES=""
# Tags applied to resources VEW provisions at runtime: the Image Builder build
# instance and its volumes, the distributed AMI, and every workbench launched
# through Service Catalog. A JSON object, empty to apply none.
#
# Set this when the target organisation requires tags on resource creation.
# An SCP of that kind denies ec2:RunInstances outright when a required tag is
# absent, so image builds and workbench launches fail with an authorization
# error rather than a missing tag.
RESOURCE_TAGS='{}'

# Spoke account (leave empty to skip)
SPOKE_ACCOUNT_ID=""
SPOKE_VPC_ID=""
